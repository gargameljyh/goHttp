{
  "name": "gohttp",
  "version": "0.1.0",
  "description": "QQ 群 AI 机器人：SnowLuma SDK 接入 OneBot，支持多厂商大模型（GLM/DeepSeek/Kimi/Qwen/OpenAI/Grok/Claude）",
  "type": "module",
  "bin": {
    "gohttp": "dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "skills",
    ".env.example"
  ],
  "keywords": [
    "qq",
    "bot",
    "onebot",
    "snowluma",
    "llm",
    "glm",
    "chatbot"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@snowluma/sdk": "^2.0.3"
  }
}
