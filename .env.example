# ===== SnowLuma =====
# OneBot v11 WebSocket 地址（SnowLuma 默认）
SNOWLUMA_WS_URL=ws://127.0.0.1:3001/
# SnowLuma accessToken；WebUI 连接配置里设置了 token 才需要填
#SNOWLUMA_TOKEN=

# ===== 智谱 GLM =====
# 必填：https://open.bigmodel.cn 控制台获取
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# ===== 机器人行为 =====
# 角色卡：从 Markdown 人设文件加载 system prompt（相对项目根目录）
# 设置后 BOT_SYSTEM_PROMPT 不再生效
#BOT_PERSONA_FILE=skills/firefly.skill/firefly_persona.md
# 人设 system prompt（留空使用内置默认；设置 BOT_PERSONA_FILE 时忽略此项）
#BOT_SYSTEM_PROMPT=你是一个运行在 QQ 里的智能助手，用中文回答，风格友好，回答保持简洁。
# 每个会话保留的历史消息条数
HISTORY_LIMIT=20

# ===== 记忆系统 =====
# 关闭后不加载也不提取记忆（/remember 等命令同样禁用）
#MEMORY_ENABLED=true
# 记忆文件目录（相对项目根目录，存为 memories.jsonl）
#MEMORY_DIR=data/memory
# 每积累多少轮对话后自动提取一次记忆
#MEMORY_EXTRACT_EVERY=5
# 单次回复最多注入的记忆条数
#MEMORY_INJECT_LIMIT=8
# 单个用户/群最多保留的记忆条数（超出淘汰命中最少且最旧的）
#MEMORY_MAX_PER_USER=50
