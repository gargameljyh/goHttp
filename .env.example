# ===== SnowLuma =====
# OneBot v11 WebSocket 地址（SnowLuma 默认）
SNOWLUMA_WS_URL=ws://127.0.0.1:3001/
# SnowLuma accessToken；WebUI 连接配置里设置了 token 才需要填
#SNOWLUMA_TOKEN=

# ===== 大模型（通用） =====
# 厂商：glm | deepseek | kimi | qwen | openai | grok | anthropic
# 内置厂商自动带默认 API 地址和默认模型；其它厂商按 OpenAI 兼容协议处理，
# 需要额外设置 LLM_BASE_URL，例如硅基流动：
#   LLM_PROVIDER=siliconflow
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_PROVIDER=glm
# 必填：对应厂商控制台获取的 API Key
LLM_API_KEY=
# 可选：覆盖内置厂商的默认地址 / 模型
#LLM_BASE_URL=
#LLM_MODEL=
# 可选：请求超时（毫秒）与单次最大输出 token（Anthropic 协议必填，默认 2048）
#LLM_TIMEOUT_MS=60000
#LLM_MAX_TOKENS=2048
#
# —— 各厂商示例（取消注释并填 Key 即可切换）——
# GLM:      LLM_PROVIDER=glm       LLM_MODEL=glm-4.6 / glm-4-flash
# DeepSeek: LLM_PROVIDER=deepseek  LLM_MODEL=deepseek-chat / deepseek-reasoner
# Kimi:     LLM_PROVIDER=kimi      LLM_MODEL=moonshot-v1-8k / kimi-k2-0711-preview
# 通义:     LLM_PROVIDER=qwen      LLM_MODEL=qwen-plus / qwen-max
# OpenAI:   LLM_PROVIDER=openai    LLM_MODEL=gpt-4o-mini / gpt-4o
# Grok:     LLM_PROVIDER=grok      LLM_MODEL=grok-3-mini
# Claude:   LLM_PROVIDER=anthropic LLM_MODEL=claude-sonnet-4-5

# ===== 机器人行为 =====
# 角色卡：从 Markdown 人设文件加载 system prompt（相对项目根目录）
# 设置后 BOT_SYSTEM_PROMPT 不再生效
#BOT_PERSONA_FILE=skills/firefly.skill/firefly_persona.md
# 人设 system prompt（留空使用内置默认；设置 BOT_PERSONA_FILE 时忽略此项）
#BOT_SYSTEM_PROMPT=你是一个运行在 QQ 里的智能助手，用中文回答，风格友好，回答保持简洁。
# 每个会话保留的历史消息条数
HISTORY_LIMIT=20

# ===== 记忆系统 =====
# 关闭后不加载也不提取记忆（/remember 等命令同样禁用）
#MEMORY_ENABLED=true
# 记忆文件目录（相对项目根目录，存为 memories.jsonl）
#MEMORY_DIR=data/memory
# 每积累多少轮对话后自动提取一次记忆
#MEMORY_EXTRACT_EVERY=5
# 单次回复最多注入的记忆条数
#MEMORY_INJECT_LIMIT=8
# 单个用户/群最多保留的记忆条数（超出淘汰命中最少且最旧的）
#MEMORY_MAX_PER_USER=50
